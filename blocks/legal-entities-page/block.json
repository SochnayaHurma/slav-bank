{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "slavbank/legal-entities-page",
  "title": "Славянбанк / Юридическим лицам",
  "category": "widgets",
  "icon": "building",
  "description": "Страница для юридических лиц с hero, повторяемыми карточками услуг и динамическим stack.",
  "textdomain": "slavbank",
  "attributes": {
    "heroTitle": {
      "type": "string",
      "default": "ЮРИДИЧЕСКИМ ЛИЦАМ"
    },
    "heroDescription": {
      "type": "string",
      "default": "Для юридических лиц АО НКБ «СЛАВЯНБАНК» предлагает следующие банковские услуги"
    },
    "heroImageUrl": {
      "type": "string",
      "default": ""
    },
    "anchorId": {
      "type": "string",
      "default": "content"
    },
    "alertTitle": {
      "type": "string",
      "default": "ЮРИДИЧЕСКИМ ЛИЦАМ"
    },
    "alertText": {
      "type": "string",
      "default": "Для юридических лиц АО НКБ «СЛАВЯНБАНК» предлагает следующие банковские услуги:"
    },
        "buttonsA": {
      "type": "array",
      "default": [{"id": 1, "url": "/napisat-v-bank/#form", "text": "Связаться", "enabled": true}, {"id": 2, "text": "На главную", "url": "/", "enabled": true}, {"id": 3, "text":"Содержание", "url": "#content", "enabled": true}]
    },
        "buttonsB": {
      "type": "array",
      "default": []
    }
  },
  "editorScript": "sb-contacts-blocks-editor",
  "style": "sb-bank-pages",
  "editorStyle": "sb-bank-pages-editor",
  "render": "file:./render.php",
  "supports": {
    "html": false,
    "inserter": false,
    "multiple": false,
    "reusable": false
  }
}